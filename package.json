    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/ui": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.2",
    "msw": "^2.15.0",
