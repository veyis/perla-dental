{
  "name": "perla_dental_clinic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "eval": "promptfoo eval -c tests/evals/promptfoo.config.yaml",
    "eval:smoke": "promptfoo eval -c tests/evals/promptfoo.config.yaml --filter-tests \"smoke\"",
    "prompt": "tsx scripts/print-system-prompt.ts",
    "prompt:full": "tsx scripts/print-system-prompt.ts full"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.72",
    "@ai-sdk/react": "^4.0.131",
    "@elevenlabs/react": "^1.16.0",
    "@ricky0123/vad-react": "^0.0.37",
    "@supabase/supabase-js": "^2.117.2",
    "ai": "^7.0.128",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.3",
    "franc-min": "^6.2.0",
    "google-auth-library": "^11.1.0",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "pino": "^10.4.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.0",
